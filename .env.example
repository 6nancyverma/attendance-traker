# Copy to .env.local and fill in real values

# MongoDB connection string (database name used: attendance_system)
MONGODB_URI=

# Secret used to sign JWT auth tokens
JWT_SECRET=

# Message returned by GET /api/ping
PING_MESSAGE="ping pong"

# ── Password reset email (SMTP) ──────────────────────────────────────────────
# Gmail requires an App Password, not your normal account password:
#   1. Enable 2-Step Verification on the Google account
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character value below (spaces are fine to remove)
# Leave blank to skip sending — the reset link is logged to the server console.
SMTP_USER=
SMTP_PASS=

# Optional. Defaults shown; only change for a non-Gmail provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="AttendanceApp <you@gmail.com>"

# Absolute base URL used to build the reset link in the email.
# Defaults to the request origin, which is fine locally.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
